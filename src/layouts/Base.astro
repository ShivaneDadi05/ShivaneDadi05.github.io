---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Contact from '../components/Contact.astro';

interface Props { title: string; description?: string; bare?: boolean; }
const {
  title,
  description = 'Shivan Dadi\'s Webpage',
  bare = false,
} = Astro.props;
const nav = [
  { href: '/writing', label: 'writing' },
  { href: '/research', label: 'research' },
  { href: '/art', label: 'art' },
  { href: '/cv', label: 'cv' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E2536" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Shivane Dadi" href="/rss.xml" />
  </head>
  <body class={bare ? 'is-bare' : undefined}>
    {bare ? (
      <slot />
    ) : (
      <div class="shell">
        <div class="topbar">
          <a class="home" href="/">Shivane Dadi</a>
          <nav>{nav.map(i => <a href={i.href}>{i.label}</a>)}</nav>
        </div>
        <slot />
        <footer>
          <Contact />
        </footer>
      </div>
    )}
  </body>
</html>
