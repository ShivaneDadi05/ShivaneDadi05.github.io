---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Shivane | Writing">
  <h1>Writing</h1>
  <p>
          I always thought people with blogs were the coolest. While there is nothing here yet, I hope to
          use this space going forward to focus on eloquating my thoughts on life and also to practice my 
          own skills in CS/Math by explaining and breaking down concepts.
    </p>
  <hr class="rule" />
  {posts.length === 0 && <p class="label">Nothing published yet.</p>}
  {posts.map(p => (
    <div class="entry">
      <a href={`/writing/${p.id}`}>{p.data.title}</a>
      <time datetime={p.data.date.toISOString()}>
        {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
      </time>
    </div>
  ))}
</Base>
