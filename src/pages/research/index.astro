---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('research'))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);
---
<Base title="Shivane | Research">
  <h1>Research</h1>
  <hr class="rule" />

  {projects.length === 0 && <p class="label">Nothing here yet.</p>}

  {projects.map(p => {
    const links = [
      { label: 'writeup',      href: p.data.writeup },
      { label: 'presentation', href: p.data.presentation },
      { label: 'paper',        href: p.data.paper },
      { label: 'code',         href: p.data.code },
      { label: 'poster',       href: p.data.poster },
    ].filter((l): l is { label: string; href: string } => Boolean(l.href));

    return (
      <section style="margin-bottom: var(--space-3);">
        <p class="label">{p.data.year}{p.data.role && ` · ${p.data.role}`}</p>
        <h2 style="margin-top:0;">{p.data.title}</h2>
        {links.length > 0 && (
          <p class="label">
            {links.map((l, i) => (
              <>
                {i > 0 && ' · '}
                <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              </>
            ))}
          </p>
        )}
        {p.data.summary.split(/\n\s*\n/).map(para => (
          <p>{para.trim()}</p>
        ))}
      </section>
    );
  })}
</Base>
